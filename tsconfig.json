{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		// The Workers runtime types come from worker-configuration.d.ts (`wrangler types`), not from @types.
		"types": []
	},
	"include": ["worker-configuration.d.ts", "src"]
}
