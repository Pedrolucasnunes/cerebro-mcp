// The Worker's configuration. Values that depend on the deployment live here and nowhere else.
// Secrets don't: they are set with `npx wrangler secret put <NAME>` (scripts/setup.mjs lists them).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cerebro-mcp",
	"main": "src/index.ts",
	"account_id": "ae6e1e9b9bf408a57f4c20d3e2aab788",
	// The newest date the installed Workers runtime supports. Move it forward on purpose, in its own PR.
	"compatibility_date": "2026-11-23",
	// The MCP handler from the `agents` package uses AsyncLocalStorage, a Node.js API.
	"compatibility_flags": ["nodejs_compat"],
	// Invocation logs, traces and Issues went off while the URL carried MCP_TOKEN (ADR 004). It's in the
	// Authorization header now (ADR 010). Turning any of them back on is a decision of its own, after
	// checking what each one records of a request's headers.
	"observability": {
		"enabled": true,
		"logs": {
			// Invocation logs record "<method> <URL>" for every request.
			"invocation_logs": false
		},
		// Traces record the URL too (url.full, url.path). They are off by default today; this keeps them off.
		"traces": {
			"enabled": false
		},
		// Issues (error monitoring) keep "request details" of failed requests. Off, like traces.
		"issues": {
			"enabled": false
		}
	},
	"vars": {
		// The private repo with the notes, and its branch that is the source of truth.
		"NOTES_REPO": "Pedrolucasnunes/cerebro-notas",
		"NOTES_BRANCH": "main"
	}
}
